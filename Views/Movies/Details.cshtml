@model MovieHub.Models.Movie

@{
    ViewData["Title"] = "Movie Details";
}

<div class="card details-card p-4">
    <span class="badge bg-primary genre-badge mb-3">
        @Model.Genre
    </span>

    <h1 class="mb-3">@Model.Title</h1>

    <p>
        <strong>Year:</strong> @Model.Year
    </p>

    <p>
        <strong>Rating:</strong> ⭐ @Model.Rating
    </p>

    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <p>
            <strong>Description:</strong>
        </p>

        <p class="text-muted">
            @Model.Description
        </p>
    }

    <div class="mt-4">
        <a href="/Movies" class="btn btn-outline-secondary me-2">
            Back to Movies
        </a>

        <a href="/Movies/Recommend" class="btn btn-primary">
            Recommendations
        </a>
    </div>
</div>